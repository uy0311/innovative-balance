			position={x=10 y=0}
			size={width=380 height=100}
			instantTextboxType={
				name="title"
				position={x=0 y=0}
				font="hoi_36header"
				text="NFM_template_title"
				maxWidth=380
				format=center
			}
			instantTextboxType={
				name="NFM_instruction"
				position={x=0 y=40}
				font="hoi_16mbs"
				text="NFM_template_text_inst"
				maxWidth=380
				format=center
			}
		}
		buttonType={
			name="NFM_close_button"
			position={x=-36 y=4}
			quadTextureSprite ="GFX_closebutton"
			shortcut="ESCAPE"
			Orientation="UPPER_RIGHT"
			clicksound=click_close
			pdx_tooltip="CLOSE"
		}
		containerWindowType={
			name="NFM_template_list_window"
			position={x=0 y=100}
			size={width=400 height=300}
			margin={top=15 left=15 bottom=15 right=30}
			verticalScrollbar="right_vertical_slider"
			scroll_wheel_factor=60
			smooth_scrolling=yes
			background={
				name="Background"
				quadTextureSprite ="GFX_tiled_window2_1b_border"
			}
			gridBoxType={
				name="NFM_template_list"
				position={x=-180 y=0}
				size={width=100%% height=100%%}
				slotsize={width=180 height=60}
				max_slots_horizontal=2
			}
		}
	}
	containerWindowType={
		name="NFM_template_item"
		position={x=0 y=0}
		size={width=180 height=60}
		#Background={
		#	name="background"
		#	spriteType="GFX_template_bg"
		#}
		buttonType={
			name="NFM_template_button"
			position={x=0 y=0}
			spriteType="GFX_template_bg"
			pdx_tooltip="NFM_template_tt_loc"
		}
		iconType={
			name="NFM_templateicon"
			position={x=0 y=10}
