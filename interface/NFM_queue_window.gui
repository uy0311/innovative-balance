
guiTypes={
	containerWindowType={
		name="NFM_OpenNFqueue"
		position={x=0 y=0}
		buttonType={
			name="NFM_OpenButton"
			position={x=0 y=0}
			spriteType="GFX_set_need_amount_button"
		}
	}
	containerWindowType={
		name="NFM_queue_window"
		position={x=0 y=50}
		size={width=400 height=600}
		moveable=yes
		click_to_front=yes
		show_sound=pop_up
		background={
			name="Background"
			spriteType ="GFX_tiled_plain_bg"
		}
		containerWindowType={
			name="NFM_title"
			position={x=0 y=0}
			size={width=400 height=100}
			instantTextboxType={
				name="title"
				position={x=0 y=0}
				font="hoi_36header"
				text="NFM_queue_title"
				maxWidth=400
				format=center
			}
			instantTextboxType={
				name="NFM_instruction"
				position={x=10 y=40}
				font="hoi_16mbs"
				text="NFM_queue_text_inst"
				maxWidth=400
				format=center
			}
			instantTextboxType={
				name="NFM_statement"
				position={x=10 y=60}
				font="hoi_16mbs"
				text="[NFM_queue_state]"
				maxWidth=400
				format=center
			}
		}
		buttonType={
			name="NFM_close_button"
			position={x=-36 y=4}
			quadTextureSprite ="GFX_closebutton"
			shortcut="ESCAPE"
			Orientation="UPPER_RIGHT"
			clicksound=click_close
			pdx_tooltip="CLOSE"
		}
		buttonType={
			name="NFM_clear_button"
			position={x=-94 y=75}
			quadTextureSprite ="GFX_leader_selection_button"
			buttonText=NFM_queue_clear_button
			buttonFont="hoi_16mbs"
			frame=1
			pdx_tooltip=NFM_queue_clear_button_tt
			Orientation="UPPER_RIGHT"
			clicksound=click_checkbox
		}
		buttonType={
			name="NFM_template_button"
			position={x=-94 y=40}
			quadTextureSprite ="GFX_leader_selection_button"
			buttonText=NFM_queue_template_button
			buttonFont="hoi_16mbs"
			frame=1
			pdx_tooltip=NFM_queue_template_button_tt
			Orientation="UPPER_RIGHT"
			clicksound=click_checkbox
		}
		containerWindowType={
			name="NFM_queue_list_window"
			position={x=0 y=100}
			size={width=400 height=500}
			margin={top=10 left=10 bottom=10 right=10}
			verticalScrollbar="right_vertical_slider"
			scroll_wheel_factor=60
			smooth_scrolling=yes
			background={
				name="Background"
				quadTextureSprite ="GFX_tiled_window2_1b_border"
			}
			gridBoxType={
				name="NFM_queue_list"
				position={x =20 y =5}
				size={width=100%% height=100%%}
				slotsize={width=400 height=60}
				max_slots_horizontal=1
				add_horizontal=no
			}
		}
	}
	containerWindowType={
		name="NFM_NF_item"
		position={x=0 y=0}
		size={width=365 height=60}
		Background={
			name="background"
			spriteType="GFX_queue_bg"
		}
		instantTextBoxType={
			name ="NFM_queue_number"
			position={x=5 y=23}
			font="hoi_16mbs"
			text="[NFM_queue_num]"
			format=center
			maxWidth=30
			maxHeight=20
		}
		iconType={
			name="NFM_NFicon"
			position={x=40 y=10}
			spriteType="GFX_goal_unknown"
			scale=0.5
		}
		instantTextboxType={
			name="NFM_NFname"
			position={x=90 y=20}
			font="hoi_20bs"
			text="[NFM_focustitle]"
			maxWidth=180
			maxHeight=60 #20
			format=center
		}
		buttonType={
			name="NFM_queue_up"
			position={x=277 y=16}
			quadTextureSprite="GFX_arrow_up_small"
			pdx_tooltip=NFM_arrow_up
		}
		buttonType={
			name="NFM_queue_down"
			position={x=299 y=16}
			quadTextureSprite="GFX_arrow_down_small"
			pdx_tooltip=NFM_arrow_down
		}
		buttonType={
			name="NFM_remove_from_queue_button"
			#position={x=-36 y=14}
			position={x=329 y=14}
			quadTextureSprite ="GFX_closebutton"
			#Orientation="UPPER_RIGHT"
			clicksound=click_close
		}
	}
	containerWindowType={
		name="NFM_template_window"
		position={x=400 y=50}
